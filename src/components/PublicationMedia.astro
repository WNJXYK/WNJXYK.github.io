---
interface Props { src: string; title: string }
const { src, title } = Astro.props;
const video = /\.(?:mp4|webm|ogv|mov|m4v)$/i.test(src.split(/[?#]/, 1)[0]);
// A small time offset also gives paused videos a visible frame on mobile Safari.
const thumbnailSrc = video && !src.includes('#') ? `${src}#t=0.1` : src;
---
<button
  type="button"
  class="thumb pub-media"
  data-media-preview
  data-media-src={src}
  data-media-kind={video ? 'video' : 'image'}
  data-media-title={title}
  aria-label={`Preview ${video ? 'video' : 'image'}: ${title}`}
  aria-haspopup="dialog"
>
  {video ? (
    <video src={thumbnailSrc} muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1" />
  ) : (
    <img src={src} alt={title} loading="lazy" decoding="async" />
  )}
  <span class="pub-media__hint" aria-hidden="true">
    {video ? (
      <svg viewBox="0 0 16 16" width="14" height="14"><path d="M5 2.5 13 8l-8 5.5Z" fill="currentColor" /></svg>
    ) : (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6V2h4m4 0h4v4M2 10v4h4m4 0h4v-4" /></svg>
    )}
  </span>
</button>
